#!/usr/bin/env bash
#
# gen-password — Secure password generator
#
# Usage: gen-password [-l LENGTH] [-s] [-a] [-h]
#
# Cross-distro: uses only /dev/urandom (available on Linux, macOS, FreeBSD).

set -euo pipefail

DEFAULT_LENGTH=32
CHARSET_ALPHANUMERIC="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
# Excludes problematic chars: ' " ` \ < > & ; | $ # % ( ) [ ] { } , \n \t
CHARSET_SYMBOLS="!@#%^&*()-_=+[]{}:.,?/|~"
CHARSET_FULL="${CHARSET_ALPHANUMERIC}${CHARSET_SYMBOLS}"

usage() {
  cat << EOF
gen-password — Secure password generator

Usage: $(basename "$0") [-l LENGTH] [-s] [-a] [-h]

Options:
  -l LENGTH   Password length (default: $DEFAULT_LENGTH)
  -s          Include safe special symbols (default: on with no flag)
  -a          Alphanumeric only (A-Z, a-z, 0-9)
  -h          Show this help
EOF
}

length="$DEFAULT_LENGTH"
use_symbols=true

while getopts "l:sah" opt; do
  case "$opt" in
    l) length="$OPTARG" ;;
    s) use_symbols=true ;;
    a) use_symbols=false ;;
    h)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

if [[ "$length" -lt 8 ]]; then
  echo "Error: minimum recommended length is 8." >&2
  exit 1
fi

if [[ "$use_symbols" == true ]]; then
  charset="$CHARSET_FULL"
else
  charset="$CHARSET_ALPHANUMERIC"
fi

# Generate password using /dev/urandom (cryptographically secure)
(set +o pipefail; LC_ALL=C tr -dc "$charset" < /dev/urandom 2>/dev/null | head -c "$length")
echo
